def get_user():
    if user:
        uid = pwd.getpwnam(user).pw_uid
        gid = pwd.getpwnam(user).pw_gid
    else:
        uid = 1000
        gid = pwd.getpwuid(uid).pw_gid
    return [uid, gid]


def install_packages(pkg_name):
    lookup = {entry['sonicde']: entry['plasma'] for entry in plasma_equivalents}
    plasma_list = lookup.get(pkg_name, [])
    if pkg_name == 'sonic-frameworks-io':
        pass
    for plasma_pkg in plasma_list:
        if run_command(f'pacman -Qq {plasma_pkg}', EXIT_CODE) == 0:
            colprint(f"Removing conflicting ¬{plasma_pkg}¬ before installing ¬{pkg_name}¬", Color.CYAN)
            run_command(f'pacman -Rdd --noconfirm {plasma_pkg}', EXIT_CODE)
    pkgs_built = glob.glob('*.pkg.tar.zst')
    for pkg in pkgs_built:
        shutil.copy(pkg, f'/packages/{pkg}')
        if sign_packages:
            shutil.copy(f'{pkg}.sig', f'/packages/{pkg}.sig')
        colprint(f'Installing package ¬{pkg}¬', Color.CYAN)
        run_command(f'pacman -U --noconfirm {pkg}', EXIT_CODE)


