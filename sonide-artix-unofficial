def get_conflicts(lines):
    content = ''.join(lines)
    pattern = re.compile(r'conflicts\s*=\s*\(([^)]*)\)', re.IGNORECASE | re.DOTALL)
    matches = pattern.findall(content)
    all_conflicts = []
    for match in matches:
        tokens = match.split()
        for token in tokens:
            token = token.strip('\'"')
            all_conflicts.append(token)
    return all_conflicts


def get_depends(pkg_dir):
    colprint(f'Installing dependacies for ¬{pkg_dir}¬', Color.CYAN)
    pkg_build_dir = os.path.join(chroot_git_dir, pkg_dir)
    if not Path(f'{pkg_build_dir}/.SRCINFO').exists():
        colprint("No ¬.SRCINFO¬ Creating one", Color.CYAN)
        os.chdir(pkg_build_dir)
        switch_to_user(normal_user)
        if run_command(f"makepkg --printsrcinfo > .SRCINFO", EXIT_CODE, shell=True):
            colprint(f"Failed to create ¬.SRCINFO¬ . Exiting", Color.RED)
            sys.exit(1)
        switch_to_user(ROOT)
    with open(f'{pkg_build_dir}/.SRCINFO') as file:
        lines = file.readlines()
    depend_list = []
    for line in lines:
        if line.strip().startswith('depends') or line.strip().startswith('makedepends') or line.strip().startswith('checkdepends'):
            pkg_name = line.split('=')[1].strip()
            if run_command(f'pacman -Qq {pkg_name}', EXIT_CODE) != 0:
                depend_list.append(pkg_name)
    return depend_list


