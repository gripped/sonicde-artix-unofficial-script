    run_command(f'cp -av {chroot_git_dir} /pkgbuilds', EXIT_CODE)
    make_new_srcinfos()
    order_built = build_sonicde_packages()
    if not quiet:
        colprint(f'Packages built in this order\n{order_built}', Color.ORANGE)
    add_repo()
    if not chroot_exit():
        colprint('Failed to cleanly exit chroot. Exiting', Color.RED)
        sys.exit(1)
    shutil.move(packages_dir, f'{cwd}/packages')
    shutil.move(f'{chroot_dir}/pkgbuilds', f'{cwd}/pkgbuilds')
    if save_last_commit:
        if not Path('/var/tmp/sonicde-artix-unofficial').exists():
            os.mkdir('/var/tmp/sonicde-artix-unofficial')
        with open('/var/tmp/sonicde-artix-unofficial/commit', 'w') as file:
            file.write(repo_last_commit)
except (Exception, SystemExit) as e:
    switch_to_user(ROOT)
    safe_exit_code = e.code
    failed = True
    if not isinstance(e, SystemExit):
        colprint("Something went wrong. Possibly the next line will tell you more? Exiting", Color.RED)
        colprint(' '.join(map(str, e.args)), Color.RED)
    if Path('/.chroot').exists():
        if not chroot_exit():
            colprint('Failed to cleanly exit chroot', Color.RED)
    failed = True

finally:
    if cleanup and safe_exit_code != 3:
        if chroot_dir and Path(chroot_dir).is_dir() and 'chroot_dir' in globals():
            mnts_not_gone = run_command(f"mount |grep {chroot_dir} | awk '{{print $3}}'", OUTPUT, shell=True).replace('\n', ' ').split(' ')[:-1]
            if not mnts_not_gone:
                colprint(f"Removing chroot ¬{chroot_dir}¬", Color.CYAN)
                shutil.rmtree(chroot_dir)
            else:
                colprint(f'Some bind mounts are still mounted ¬{mnts_not_gone}¬. Exiting', Color.RED)
                sys.exit(1)
        else:
            sys.exit(1)
    if missing:
        colprint(f'{missing} not built', Color.ORANGE)
    if failed:
        sys.exit(1)
