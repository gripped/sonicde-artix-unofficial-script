def plasma_equivs():
    equiv_list = []
    for p_dir in package_dirs:
        pkgbuild = os.path.join(os.path.join(chroot_git_dir, p_dir, 'PKGBUILD'))
        with open(pkgbuild) as file:
            pkgbuild_lines = file.readlines()
        equiv = get_conflicts(pkgbuild_lines)
        equiv_list.append({
            'plasma': equiv,
            'sonicde': p_dir
        })
    if not quiet:
        colprint('List of installed sonicde packages and their plasma equivalents.', Color.CYAN)
        for equiv in equiv_list:
            print(f"sonicde: {equiv['sonicde']:<40} plasma: {', '.join(equiv['plasma'])}")
    return equiv_list


def run_command(cmd, opt, shell=False):
    try:
        if print_sys_cmds:
            colprint(f'{cmd}', Color.GREEN)
        if not shell:
            cmd = shlex.split(cmd)
        process = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, shell=shell, text=True, user=os.geteuid(), group=os.getegid())
        os.set_blocking(process.stdout.fileno(), False)
        os.set_blocking(process.stderr.fileno(), False)
        stdout_lines = []
        while True:
            stdout_line = process.stdout.readline()
            stderr_line = process.stderr.readline()
            if stdout_line:
                stdout_lines.append(stdout_line)
                if not quiet:
                    print(stdout_line, end='')
            if stderr_line:
                if not quiet:
                    print(stderr_line, end='')
            if process.poll() is not None and stdout_line == '' and stderr_line == '':
                break
        if opt == OUTPUT:
            return ''.join(stdout_lines)
        if opt == EXIT_CODE:
            return process.returncode
    except Exception as e:
        colprint(*e.args, Color.RED)
        if opt == OUTPUT:
            return 'Error'
        if opt == EXIT_CODE:
            return 1


def switch_to_user(usr):
    os.setegid(usr[1])
    os.seteuid(usr[0])


def tmp_mkpkg_conf():
    colprint("Creating temporary ¬makepkg.conf¬", Color.CYAN)
    with open(f'/etc/makepkg.conf', 'r') as file:
        lines = file.readlines()
        if sign_packages:
            for i, line in enumerate(lines):
                if line.lstrip().startswith('PACKAGER='):
                    lines[i] = f'PACKAGER="{packager}"\n'
                if line.lstrip().startswith('GPGKEY='):
                    lines[i] = f'GPGKEY="{key_fp}"\n'
                if line.lstrip().startswith('BUILDENV=('):
                    target = 'ccache' if ccache else '!ccache'
                    if re.search(r'\b!?ccache\b', line):
                        lines[i] = re.sub(r'\b!?ccache\b', target, line)
                    else:
                        lines[i] = re.sub(r'(BUILDENV=\()([^)]*)(\))', rf'\1\2 {target}\3', line)

    with open(f'{chroot_dir}/makepkg.conf', 'w') as file:
        file.writelines(lines)


