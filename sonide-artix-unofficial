def chroot_setup():
    def chroot_mounts():
        total_exit_code = 0
        exit_code = run_command(f"mount -v --bind {chroot_dir} {chroot_dir}", EXIT_CODE)
        total_exit_code += exit_code
        exit_code = run_command(f"mount -v --types proc /proc {chroot_dir}/proc", EXIT_CODE)
        total_exit_code += exit_code
        exit_code = run_command(f"mount -v --rbind --make-rslave /sys {chroot_dir}/sys", EXIT_CODE)
        total_exit_code += exit_code
        exit_code = run_command(f"mount -v --rbind --make-rslave /dev {chroot_dir}/dev", EXIT_CODE)
        total_exit_code += exit_code
        if sign_packages:
            os.mkdir(f'{chroot_dir}/key')
            exit_code = run_command(f"mount -v --bind {key_dir} {chroot_dir}/key", EXIT_CODE)
            total_exit_code += exit_code
            shutil.copy(os.path.join(chroot_dir, 'key', key_private_name), os.path.join(chroot_dir, 'key', 'temp.asc'))
            os.chown(os.path.join(chroot_dir, 'key', 'temp.asc'), normal_user[0], normal_user[1])
        if ccache:
            os.mkdir(f'{chroot_dir}/ccache')
            exit_code = run_command(f"mount -v --bind {ccache_dir} {chroot_dir}/ccache", EXIT_CODE)
            total_exit_code += exit_code
        if total_exit_code:
            return False
        return True

    chroot_make()
    os.chdir(chroot_dir)
    if not chroot_mounts():
        colprint('bind mounts failed. Exiting', Color.RED)
        sys.exit(1)
    os.chroot(chroot_dir)
    if not Path('/.chroot').exists():
        colprint("We don't seem to be in the chroot? Exiting", Color.RED)
        sys.exit(1)
    total_exit_code = 0
    exit_code = run_command(r"sed -i 's/^#en_GB.UTF-8 UTF-8/en_GB.UTF-8 UTF-8/' /etc/locale.gen", EXIT_CODE)
    total_exit_code += exit_code
    exit_code = run_command("locale-gen", EXIT_CODE)
    total_exit_code += exit_code
    with open("/etc/locale.conf", "w") as f:
        f.write("LANG=en_GB.UTF-8\n")
    os.environ["LANG"] = "en_GB.UTF-8"
    os.environ["LC_ALL"] = "en_GB.UTF-8"
    if ccache:
        os.environ["CCACHE_DIR"] = "/ccache"
        os.environ["LC_ALL"] = "en_GB.UTF-8"
    exit_code = run_command('pacman-key --init', EXIT_CODE)
    total_exit_code += exit_code
    exit_code = run_command('pacman-key --populate artix', EXIT_CODE)
    total_exit_code += exit_code
    exit_code = run_command(f"pacman -Syu --noconfirm {'ccache ' if ccache else ''}", EXIT_CODE)
    total_exit_code += exit_code
    if sign_packages:
        exit_code = run_command(f'pacman-key --add /key/{key_public_name}', EXIT_CODE)
        total_exit_code += exit_code
        exit_code = run_command(f'pacman-key --finger {key_fp}', EXIT_CODE)
        total_exit_code += exit_code
        exit_code = run_command(f'pacman-key --lsign-key {key_fp}', EXIT_CODE)
        total_exit_code += exit_code
        exit_code = run_command('useradd -m user', EXIT_CODE)
        total_exit_code += exit_code
        switch_to_user(normal_user)
        exit_code = run_command('GNUPGHOME=/home/user/.gnupg gpg --import /key/temp.asc', EXIT_CODE, shell=True)
        total_exit_code += exit_code
        switch_to_user(ROOT)
        os.remove('/key/temp.asc')
    if total_exit_code:
        return False
    return True


def colprint(text, color=Color.END):
    parts = text.split('¬')
    for i, part in enumerate(parts):
        if i % 2 == 0:
            print(color, end='')
        else:
            print(Color.END, end='')
        print(part, end='')
    print(f'{Color.END}')


